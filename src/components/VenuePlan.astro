---
// The venue's plan, drawn: its rooms in ink, the entrance, and a pin dropped on each room the festival uses.
interface Props {
  note: string;
}

const { note } = Astro.props;
---

<div class="reveal border-2 bg-tertiary-50 p-4.5 dark:bg-neutral-800">
  <svg class="block h-auto w-full" viewBox="0 0 520 340" role="img" aria-label="A floor plan of the Dye Works: the Main Hall, the Press Room, the Yard, the paper market and the entrance">
    <g class="fill-none stroke-current stroke-3">
      <rect x="10" y="10" width="300" height="200" />
      <rect x="310" y="10" width="200" height="130" />
      <rect x="310" y="140" width="200" height="190" />
      <rect x="10" y="210" width="300" height="120" />
      <path d="M150 330 v-30" />
    </g>
    <g class="fill-current text-ui font-bold">
      <text x="28" y="44">Main Hall</text>
      <text x="328" y="44">Press Room</text>
      <text x="328" y="174">The Yard</text>
      <text x="28" y="244">Paper market</text>
      <text x="160" y="322">Entrance</text>
    </g>
    <g class="pin fill-primary-500 dark:fill-primary-400" style="--i: 0"><circle cx="160" cy="110" r="14" /></g>
    <g class="pin fill-secondary-500 dark:fill-secondary-400" style="--i: 1"><circle cx="410" cy="80" r="14" /></g>
    <g class="pin fill-primary-500 dark:fill-primary-400" style="--i: 2"><circle cx="410" cy="250" r="14" /></g>
  </svg>
  <p class="mt-3 text-ui leading-plan">{note}</p>
</div>
