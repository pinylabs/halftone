---
// A page the press never printed.
import Site from "../layouts/Site.astro";
---

<Site title="Misprint">
  <main class="wrap pt-11 pb-22">
    <h1 class="page-title">Mis<em>print</em></h1>
    <p class="mt-5.5 max-w-lede text-lede max-md:text-lede-sm">This page never made it to the press.</p>
    <p class="mt-6.5 flex flex-wrap gap-6.5 font-bold">
      <a class="border-b-2 border-primary-500 dark:border-primary-400" href="/">The festival →</a>
      <a class="border-b-2 border-primary-500 dark:border-primary-400" href="/programme/">The programme →</a>
    </p>
  </main>
</Site>
